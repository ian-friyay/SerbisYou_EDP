# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase Database Configuration
# Get these credentials from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Directus CMS Configuration (Admin Panel)
DIRECTUS_URL=https://your-directus-instance-url.com
DIRECTUS_STATIC_TOKEN=your-directus-static-token-if-needed
